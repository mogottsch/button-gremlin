DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=

# Legacy default is cwd tags.json. After migrating existing tags, production uses
# /app/sounds/metadata/tags.json on the existing sounds PVC.
BUTTON_GREMLIN_TAGS_FILE=tags.json

# Bot-only mode requires no OIDC or Redis configuration.
WEB_ENABLED=false
WEB_PORT=3000
BUTTON_GREMLIN_APP_ORIGIN=https://button-gremlin.moket-home.de
OIDC_ISSUER=https://authentik.moket-home.de/application/o/button-gremlin/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://button-gremlin.moket-home.de/api/auth/callback
OIDC_BROKER_BASE_URL=https://identity.moket-home.de
BUTTON_GREMLIN_SESSION_SECRET=
REDIS_URL=
# Never enable test HTTP/cookie mode in production.
OIDC_ALLOW_INSECURE_TEST=false
# Independent service-wide machine credential, not a browser login.
AUTOMATION_API_ENABLED=false
WEB_API_KEY=
